NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="My Site"
NEXT_PUBLIC_SITE_META_DESCRIPTION="A short description of this site, used in search results and link previews."

# --- Analytics (optional) ---
# PostHog, configured cookieless in src/instrumentation-client.ts: no cookies,
# no local storage, no consent banner required. Leave the key blank and
# analytics never initializes — the app makes no third-party requests at all.
# Project token from PostHog → Settings → Project → Project API key.
#
# Cookieless mode also has a server-side half: enable "Cookieless server hash
# mode" under Settings → Project, or PostHog captures nothing at all.
#
# What cookieless costs, so an empty dashboard is not mistaken for a bug:
# PostHog strips the IP after hashing and before enrichment, so GeoIP and bot
# detection never run. Getting either back means cookies, a consent banner,
# and a rewritten privacy notice.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=""
# EU Cloud by default. Only change this if your PostHog project lives in the US
# region ("https://us.i.posthog.com"), which brings UK→US transfer obligations
# that the EU region does not.
NEXT_PUBLIC_POSTHOG_HOST="https://eu.i.posthog.com"

# --- Contact form (optional) ---
# The site is static, so the form posts straight from the browser to a hosted
# form service that emails each enquiry on. Leave blank and the form sends
# nothing, says so, and points visitors to the email address instead.
#
# Any service that accepts a POST with `Accept: application/json` works. With
# Formspree: create a form at formspree.io and paste its endpoint here, e.g.
# "https://formspree.io/f/abcdwxyz". /privacy names the service from this URL.
#
# This is baked in at build time, so the GitHub Pages build needs it set too.
NEXT_PUBLIC_CONTACT_FORM_ENDPOINT=""

# --- Contact email (required) ---
# The studio's public address: the footer and Contact section show it, and
# /privacy uses it for data-protection enquiries (the UK GDPR requires a route
# for people to exercise their rights). Without it those links are empty.
NEXT_PUBLIC_PRIVACY_EMAIL="hello@742studios.dev"
